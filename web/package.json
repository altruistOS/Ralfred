{
  "name": "ralfred-web",
  "private": true,
  "version": "0.1.0",
  "description": "Search-panel web UI for the ralfred launcher (React 18 + esbuild, no vite).",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --minify --jsx=automatic --loader:.css=text --outfile=dist/bundle.js",
    "dev": "esbuild src/index.tsx --bundle --minify --jsx=automatic --loader:.css=text --outfile=dist/bundle.js --watch",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.1",
    "typescript": "^5.7.3"
  }
}
